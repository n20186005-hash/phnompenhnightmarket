---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, getI18n } from '../../i18n/ui';

const { messages } = getI18n(Astro.url);
const d = messages.cookieSettings;
---

<BaseLayout title={d.title} description={d.title}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8 border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">{d.title}</h1>
      <p class="mt-2 text-sm text-slate-500">{d.lastUpdated}</p>
    </header>

    <p class="mb-8 text-slate-700 leading-relaxed">{d.description}</p>

    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-slate-900">{d.essential.title}</h2>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{d.essential.badge}</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">{d.essential.description}</p>
      </div>

      <div class="rounded-xl border border-slate-200 p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-slate-900">{d.analytics.title}</h2>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-700">{d.analytics.state}</span>
        </div>
        <p class="mt-1 text-xs font-medium text-teal-700">{d.analytics.provider}</p>
        <p class="mt-1 text-sm text-slate-600">{d.analytics.description}</p>
        <p class="mt-1 text-sm text-slate-500">{d.analytics.desc2}</p>
      </div>

      <div class="rounded-xl border border-slate-200 p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-slate-900">{d.preferences.title}</h2>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-700">{d.preferences.state}</span>
        </div>
        <p class="mt-1 text-xs font-medium text-teal-700">{d.preferences.provider}</p>
        <p class="mt-1 text-sm text-slate-600">{d.preferences.description}</p>
        <p class="mt-1 text-sm text-slate-500">{d.preferences.desc2}</p>
      </div>

      <div class="rounded-xl border border-slate-200 p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-slate-900">{d.marketing.title}</h2>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{d.marketing.state}</span>
        </div>
        <p class="mt-1 text-xs font-medium text-teal-700">{d.marketing.provider}</p>
        <p class="mt-1 text-sm text-slate-600">{d.marketing.description}</p>
        <p class="mt-1 text-sm text-slate-500">{d.marketing.desc2}</p>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <button type="button" class="rounded-full bg-teal-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600">{d.save}</button>
      <button type="button" class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">{d.rejectAll}</button>
    </div>

    <p class="mt-8 text-xs leading-relaxed text-slate-500">{d.consentNote}</p>

    <a href={getLangFromUrl(Astro.url) === 'km' ? '/' : `/${getLangFromUrl(Astro.url)}/`}
       class="mt-10 inline-flex items-center gap-2 rounded-full bg-teal-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600">
      ← {messages.backToHome}
    </a>
  </article>
</BaseLayout>
