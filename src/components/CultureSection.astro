---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const culture = messages.culture;
---

<section id="culture" class="bg-white/60 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-3xl font-bold text-gray-900">{culture.title}</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {
        culture.body.map((p: string, i: number) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-teal-700 text-white">{i + 1}</span>
            <p class="mt-4 text-gray-600">{p}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
