---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const f = messages.facilities;
---

<section id="facilities" class="bg-teal-50/40 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-3xl font-bold text-gray-900">{f.title}</h2>
    <p class="mt-3 max-w-3xl text-gray-600">{f.subtitle}</p>
    <p class="mt-3 inline-block rounded-full bg-amber-50 px-4 py-1.5 text-xs font-medium text-amber-800">
      {f.disclaimer}
    </p>

    {
      f.groups.map((group: any) => (
        <div class="mt-10">
          <h3 class="text-xl font-semibold text-teal-800">{group.title}</h3>
          <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item: any) => (
              <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
                <div class="grid h-12 w-12 place-items-center rounded-xl bg-teal-50 text-2xl">{item.icon}</div>
                <h4 class="mt-4 font-semibold text-gray-900">{item.title}</h4>
                <ul class="mt-3 space-y-2 text-sm leading-relaxed text-gray-600">
                  {item.points.map((p: string) => (
                    <li class="flex gap-2">
                      <span class="mt-1 text-teal-500">•</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))
    }

    <h3 class="mt-12 text-xl font-semibold text-teal-800">{f.tipsTitle}</h3>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        f.tips.map((item: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="grid h-12 w-12 place-items-center rounded-xl bg-amber-50 text-2xl">{item.icon}</div>
            <h4 class="mt-4 font-semibold text-gray-900">{item.title}</h4>
            <p class="mt-2 text-sm text-gray-600">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
