---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const f = messages.food;
---

<section id="food" class="bg-white/60 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
      <div>
        <h2 class="text-3xl font-bold text-gray-900">{f.title}</h2>
        <p class="mt-2 max-w-2xl text-gray-600">{f.intro}</p>
      </div>
      <span class="rounded-full bg-orange-100 px-4 py-1.5 text-sm font-medium text-amber-700">🍜</span>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        f.items.map((item: any) => (
          <div class="flex items-start gap-4 rounded-2xl border border-black/5 bg-white p-5 shadow-sm">
            <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-orange-50 text-2xl">{item.icon}</div>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
