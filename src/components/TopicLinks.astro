---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { extraGuides, extraGuideSlugs } from '../i18n/extraGuides';

const lang = getLangFromUrl(Astro.url);
const { messages } = getI18n(Astro.url);
const langHrefs: Record<string, string> = { km: '/', en: '/en/', zh: '/zh/' };
const base = langHrefs[lang] ?? '/';

const topics = ['opening-hours', 'food', 'getting-there', ...extraGuideSlugs];
const cards = topics.map((t) => ({
  slug: t,
  nav: (messages.topics[t] ?? extraGuides[lang][t]).nav,
  desc: (messages.topics[t] ?? extraGuides[lang][t]).cardDesc,
  href: `${base}${t}/`,
}));

const title = messages.topicLinks?.title ?? 'Practical Guides';
const intro = messages.topicLinks?.intro ?? '';
---

<section id="guides" class="mx-auto max-w-6xl px-4 py-12">
  <div class="flex items-center gap-3">
    <span class="grid h-10 w-10 place-items-center rounded-full bg-teal-700 text-white">🧭</span>
    <h2 class="text-2xl font-bold text-gray-900">{title}</h2>
  </div>
  {intro && <p class="mt-3 max-w-3xl text-gray-600">{intro}</p>}

  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    {
      cards.map((c) => (
        <a
          href={c.href}
          class="group flex flex-col rounded-3xl border border-teal-900/10 bg-gradient-to-br from-teal-50 to-amber-50 p-6 transition hover:shadow-md"
        >
          <span class="text-lg font-bold text-gray-900 group-hover:text-teal-700">{c.nav}</span>
          <span class="mt-2 text-sm text-gray-600">{c.desc}</span>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-teal-700">
            {messages.topicLinks?.readMore ?? 'Read more'} →
          </span>
        </a>
      ))
    }
  </div>
</section>
