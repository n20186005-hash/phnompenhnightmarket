---
import { getI18n } from '../i18n/ui';
const { messages, lang } = getI18n(Astro.url);
const intro = messages.intro;
const seatingAlt = lang === 'zh' ? '金边夜市露天广场的草席聚餐实景' : lang === 'km' ? 'ភ្ញៀវអង្គុយទទួលទានអាហារលើកន្ទេលនៅផ្សាររាត្រីភ្នំពេញ' : 'Visitors dining on mats in the open-air Phnom Penh Night Market';
---

<section id="intro" class="mx-auto max-w-6xl px-4 py-14">
  <div class="grid items-center gap-10 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-gray-900">{intro.title}</h2>
      <div class="mt-5 space-y-4 text-gray-600">
        {intro.body.map((p: string) => <p>{p}</p>)}
      </div>
    </div>

    <div class="relative grid grid-cols-2 gap-3">
      <img src="/gallery/phnom-penh-night-market-9.jpg" alt={messages.gallery.alts[8]} width="4080" height="3072" loading="lazy" decoding="async" class="aspect-[3/4] w-full rounded-2xl object-cover shadow-lg" />
      <img src="/gallery/phnom-penh-night-market-10.jpg" alt={seatingAlt} width="4624" height="3472" loading="lazy" decoding="async" class="mt-8 aspect-[3/4] w-full rounded-2xl object-cover shadow-lg" />
    </div>
  </div>
</section>
