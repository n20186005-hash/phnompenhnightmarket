---
import { getLangFromUrl, getI18n } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const { messages } = getI18n(Astro.url);
const f = messages.footer;

const year = new Date().getFullYear();
const rights = `© ${year} ${f.siteName} · ${lang === 'zh' ? '版權所有' : lang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង' : 'All rights reserved'}`;
const independence = lang === 'zh'
  ? '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。'
  : lang === 'km'
    ? 'គេហទំព័រនេះជាគម្រោងព័ត៌មានទេសចរណ៍ឯករាជ្យ។ យើងមិនមានទំនាក់ទំនងជាមួយស្ថាប័នរដ្ឋាភិបាល ឬអង្គការផ្លូវការណាមួយឡើយ។'
    : 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.';

const langHrefs: Record<string, string> = {
  km: '/',
  en: '/en/',
  zh: '/zh/',
};
---

<footer class="mt-8 bg-teal-950 text-teal-50">
  <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-8 md:flex-row md:items-start md:justify-between">
    <div class="text-sm text-teal-100/80">
      <p>{rights}</p>
      <p class="mt-2 max-w-xl">{independence}</p>
    </div>
    <nav aria-label={f.legalTitle} class="md:text-right">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm md:justify-end">
        <li><a href={`${langHrefs[lang]}privacy-policy/`} class="text-teal-100/80 transition hover:text-white">{f.privacy}</a></li>
        <li><a href={`${langHrefs[lang]}terms-of-service/`} class="text-teal-100/80 transition hover:text-white">{f.terms}</a></li>
        <li><a href={`${langHrefs[lang]}cookie-settings/`} class="text-teal-100/80 transition hover:text-white">{f.cookies}</a></li>
      </ul>
    </nav>
  </div>
</footer>
