---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const tips = messages.tips;
---

<section id="tips" class="bg-white/60 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-3xl font-bold text-gray-900">{tips.title}</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        tips.items.map((item: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="grid h-12 w-12 place-items-center rounded-xl bg-orange-50 text-2xl">{item.icon}</div>
            <h3 class="mt-4 font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
