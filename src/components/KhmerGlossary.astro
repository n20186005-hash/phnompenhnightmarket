---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const g = messages.glossary;
---

<section id="glossary" class="mx-auto max-w-6xl px-4 py-14">
  <div class="rounded-3xl border border-teal-900/10 bg-gradient-to-br from-teal-50 to-amber-50 p-8 shadow-sm">
    <div class="flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-teal-700 text-white">💡</span>
      <h2 class="text-2xl font-bold text-gray-900">{g.title}</h2>
    </div>
    <p class="mt-3 max-w-2xl text-gray-600">{g.intro}</p>

    <dl class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        g.terms.map((t: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-5">
            <dt class="font-semibold text-teal-800">{t.word}</dt>
            <dd class="mt-1 text-sm text-gray-600">{t.meaning}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
