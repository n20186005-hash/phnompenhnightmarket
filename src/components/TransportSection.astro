---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const t = messages.transport;
---

<section id="transport" class="bg-white/60 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-3xl font-bold text-gray-900">{t.title}</h2>
    <p class="mt-2 max-w-3xl text-gray-600">{t.intro}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.modes.map((m: any) => (
          <article class="flex h-full flex-col rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="flex items-start gap-3">
              <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-teal-700/10 text-2xl">
                {m.icon}
              </div>
              <div class="min-w-0">
                <h3 class="font-semibold text-gray-900">{m.title}</h3>
                {m.tag && (
                  <span class="mt-1 inline-block rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800">
                    {m.tag}
                  </span>
                )}
              </div>
            </div>

            <dl class="mt-4 grid grid-cols-[auto_1fr] items-baseline gap-x-3 gap-y-1.5 text-sm">
              <dt class="text-gray-500">{t.labels.from}</dt>
              <dd class="text-gray-800">{m.from}</dd>
              <dt class="text-gray-500">{t.labels.time}</dt>
              <dd class="text-gray-800">{m.time}</dd>
              <dt class="text-gray-500">{t.labels.cost}</dt>
              <dd class="text-gray-800">{m.cost}</dd>
            </dl>

            <ul class="mt-4 flex-1 space-y-2 border-t border-black/5 pt-4 text-sm text-gray-600">
              {m.points.map((p: string) => (
                <li class="flex gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-600/60" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
        <h3 class="flex items-center gap-2 font-semibold text-amber-900">📍 {t.dropoff.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-amber-900/80">{t.dropoff.desc}</p>
      </div>
      <div class="rounded-2xl border border-teal-200 bg-teal-50 p-6">
        <h3 class="flex items-center gap-2 font-semibold text-teal-900">🛡️ {t.returnNote.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-teal-900/80">{t.returnNote.desc}</p>
      </div>
    </div>

    <p class="mt-4 text-xs text-gray-500">{t.costNote}</p>
  </div>
</section>
