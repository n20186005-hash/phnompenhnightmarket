---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const t = messages.transport;
---

<section id="transport" class="bg-white/60 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-3xl font-bold text-gray-900">{t.title}</h2>
    <p class="mt-2 max-w-2xl text-gray-600">{t.intro}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.modes.map((m: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="grid h-12 w-12 place-items-center rounded-xl bg-teal-700/10 text-2xl">{m.icon}</div>
            <h3 class="mt-4 font-semibold text-gray-900">{m.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{m.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
