---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const s = messages.shopping;
---

<section id="shopping" class="mx-auto max-w-6xl px-4 py-14">
  <div class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <h2 class="text-3xl font-bold text-gray-900">{s.title}</h2>
      <p class="mt-2 max-w-2xl text-gray-600">{s.intro}</p>
    </div>
    <span class="rounded-full bg-orange-100 px-4 py-1.5 text-sm font-medium text-amber-700">🛍️</span>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      s.items.map((item: any) => (
        <div class="group rounded-2xl border border-black/5 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-orange-50 text-2xl">{item.icon}</div>
          <h3 class="mt-4 font-semibold text-gray-900">{item.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{item.desc}</p>
        </div>
      ))
    }
  </div>

  {
    s.notes && (
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <h3 class="font-semibold text-teal-800">{s.notes.stallsTitle}</h3>
          <p class="mt-2 text-sm text-gray-600">{s.notes.stalls}</p>
        </div>
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <h3 class="font-semibold text-teal-800">{s.notes.bargainTitle}</h3>
          <p class="mt-2 text-sm text-gray-600">{s.notes.bargain}</p>
        </div>
      </div>
    )
  }
</section>
